{#- Page header: eyebrow (group), title, "Copy page" button and description ~#}
{%- set eyebrow = page.eyebrow ?? (page.parent.title ?? null) ~%}
{%- set show_title = '<h1' not in page.content ~%}
          <header id="page-header" class="mb-8">
            {%- if eyebrow ~%}
            <p class="leon-eyebrow mb-2">{{ eyebrow }}</p>
            {%- endif ~%}
            <div class="flex flex-col-reverse gap-4 sm:flex-row sm:items-start sm:justify-between">
              {%- if show_title ~%}
              <h1 id="page-title" class="leon-title">{{ page.title }}</h1>
              {%- endif ~%}
              {{- include('partials/leon/copy-page.html.twig') ~}}
            </div>
            {%- if page.description is defined and page.description ~%}
            <p class="mt-3 text-lg leading-[1.65] text-body">{{ page.description }}</p>
            {%- endif ~%}
          </header>