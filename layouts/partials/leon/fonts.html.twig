{#- Bundled fonts (SIL Open Font License): Hanken Grotesk (body) and Newsreader (headings).
Linked as assets: `url()` would prefix a static file path with the current language. ~#}
{%- if site.leon.fonts.bundled ?? true ~%}
    <link rel="preload" href="{{ url(asset('fonts/hanken-grotesk-latin-wght-normal.woff2')) }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ url(asset('fonts/newsreader-latin-opsz-normal.woff2')) }}" as="font" type="font/woff2" crossorigin>
    <style>{% apply minify_css ~%}
      {%- set latin = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD' ~%}
      {%- set latin_ext = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF' ~%}
      {%- for style in ['normal', 'italic'] %}
      @font-face {
        font-family: 'Hanken Grotesk';
        font-style: {{ style }};
        font-weight: 100 900;
        font-display: swap;
        src: url('{{ url(asset('fonts/hanken-grotesk-latin-ext-wght-' ~ style ~ '.woff2')) }}') format('woff2-variations');
        unicode-range: {{ latin_ext }};
      }
      @font-face {
        font-family: 'Hanken Grotesk';
        font-style: {{ style }};
        font-weight: 100 900;
        font-display: swap;
        src: url('{{ url(asset('fonts/hanken-grotesk-latin-wght-' ~ style ~ '.woff2')) }}') format('woff2-variations');
        unicode-range: {{ latin }};
      }
      {%- endfor %}
      @font-face {
        font-family: 'Newsreader';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url('{{ url(asset('fonts/newsreader-latin-ext-opsz-normal.woff2')) }}') format('woff2-variations');
        unicode-range: {{ latin_ext }};
      }
      @font-face {
        font-family: 'Newsreader';
        font-style: normal;
        font-weight: 200 800;
        font-display: swap;
        src: url('{{ url(asset('fonts/newsreader-latin-opsz-normal.woff2')) }}') format('woff2-variations');
        unicode-range: {{ latin }};
      }
    {% endapply %}</style>
{%- endif ~%}